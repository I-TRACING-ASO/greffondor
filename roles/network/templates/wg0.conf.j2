[Interface]
Address = {{ wg_client_ip }}
PrivateKey = {{ wg_private_key }}
DNS = 1.1.1.1

#PostUp = ip route add 10.0.0.0/8 dev eth0 table 100
#PostUp = ip route add 10.0.0.0/24 dev wg0 table 100
PostUp = ip route add 172.16.0.0/12 dev eth0 table 100
PostUp = ip route add 192.168.0.0/16 dev eth0 table 100
PostUp = ip route add default dev eth0 table 100
#PostUp = ip rule add to 10.0.0.0/8 table 100 priority 1000
PostUp = ip rule add to 172.16.0.0/12 table 100 priority 1000
PostUp = ip rule add to 192.168.0.0/16 table 100 priority 1000
#PostUp = ip route del 10.0.0.0/8 table 51820 2>/dev/null || true
#PostUp = ip route add 10.0.0.0/24 dev wg0 table 51820
PostUp = ip route del 172.16.0.0/12 table 51820 2>/dev/null || true
PostUp = ip route del 192.168.0.0/16 table 51820 2>/dev/null || true

#PreDown = ip rule del to 10.0.0.0/8 table 100 2>/dev/null || true
#PreDown = ip route del 10.0.0.0/24 dev wg0 table 100
PreDown = ip rule del to 172.16.0.0/12 table 100 2>/dev/null || true
PreDown = ip rule del to 192.168.0.0/16 table 100 2>/dev/null || true
PreDown = ip route flush table 100 2>/dev/null || true
PreDown = ip route del default dev eth1 table 51820 2>/dev/null || true


[Peer]
PublicKey = {{ wg_server_pubkey }}
Endpoint = {{ wg_server_ip }}:{{ wg_server_port }}
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
PresharedKey = {{ wg_preshared_key }}
